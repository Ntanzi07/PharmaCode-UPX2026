# --- Postgres ---
DB_USER=bula
DB_PASSWORD=bula_password
DB_NAME=bula
# Porta exposta na sua maquina (dentro do compose o banco continua na 5432)
DB_PORT=5433

# --- API ---
PORT=8080
API_PORT=8080

# Usada apenas quando voce roda a API fora do Docker (go run ./cmd/api).
# No compose o servico "api" recebe a sua propria DATABASE_URL apontando para o host "db".
DATABASE_URL=postgres://bula:bula_password@localhost:5433/bula?sslmode=disable

# --- Login do painel ---
# Duracao da sessao (ex.: 12h, 30m)
SESSION_TTL=12h
# true quando o painel estiver em HTTPS (o cookie so trafega criptografado)
COOKIE_SECURE=false
# Primeiro admin: criado so quando o banco ainda nao tem nenhum usuario.
# Depois de entrar, troque a senha pelo painel e pode apagar estas linhas.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@pharmacode.local
ADMIN_PASSWORD=troque-esta-senha
