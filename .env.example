# --- Postgres ---
DB_USER=bula
DB_PASSWORD=bula_password
DB_NAME=bula
# Porta exposta na sua maquina (dentro do compose o banco continua na 5432)
DB_PORT=5433

# --- API ---
PORT=8080
API_PORT=8080

# Usada apenas quando voce roda a API fora do Docker (go run ./cmd/api).
# No compose o servico "api" recebe a sua propria DATABASE_URL apontando para o host "db".
DATABASE_URL=postgres://bula:bula_password@localhost:5433/bula?sslmode=disable
