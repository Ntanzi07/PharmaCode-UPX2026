# --- Postgres ---
DB_USER=bula
DB_PASSWORD=bula_password
DB_NAME=bula
# Port exposed on your machine (inside compose the database stays on 5432)
DB_PORT=5433

# --- API ---
PORT=8080
API_PORT=8080

# Only used when you run the API outside Docker (go run ./cmd/api).
# In compose, the "api" service gets its own DATABASE_URL pointing to the "db" host.
DATABASE_URL=postgres://bula:bula_password@localhost:5433/bula?sslmode=disable

# --- Admin panel login ---
# Session duration (e.g. 12h, 30m)
SESSION_TTL=12h
# true when the panel is served over HTTPS (the cookie only travels encrypted)
COOKIE_SECURE=false
# First admin: only created when the database has no users yet.
# After logging in, change the password in the panel; these lines can then be removed.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@pharmacode.local
# Must have at least 8 characters
ADMIN_PASSWORD=troque-esta-senha
